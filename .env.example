# =============================================================================
# EVENTHON - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
API_VERSION=1

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=32-char-encryption-key-here!!!!

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventhon_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Eventhon
SMTP_FROM_EMAIL=no-reply@eventhon.io

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=50

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=eventhon-uploads

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=30000
AI_ENABLED=true

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Monitoring (optional)
SENTRY_DSN=

# Bull Queue
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
